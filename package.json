{
  "name": "legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Futbol Super League: a 3D arcade football game with clubs, national teams and legends, built with three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "tsx scripts/generate-assets.mjs",
    "preview": "vite preview",
    "assets": "tsx scripts/generate-assets.mjs",
    "db:validate": "tsx scripts/validate-db.mjs",
    "test": "tsx tests/physics.test.mjs && tsx tests/mechanics.test.mjs && tsx tests/character.test.mjs && tsx tests/sim.test.mjs && tsx tests/db.test.mjs && tsx scripts/validate-db.mjs && tsx tests/engine.test.ts && tsx tests/match-engine.test.ts && tsx tests/gameplay-feel.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/game-engine",
    "test:engine": "tsx tests/engine.test.ts",
    "lab": "vite --open /dev/player-ball-lab.html",
    "test:match-engine": "tsx tests/match-engine.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
